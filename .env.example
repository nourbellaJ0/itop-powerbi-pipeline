# ============================================================
# .env.example — Modèle de configuration du pipeline iTop → Power BI
#
# INSTRUCTIONS :
#   1. Copier ce fichier en ".env" dans le même répertoire
#   2. Remplir toutes les valeurs selon votre mode d'utilisation
#   3. NE JAMAIS committer le fichier .env dans Git
#   4. Ajouter .env à votre .gitignore
#
# SECURITE :
#   Ce fichier est un MODELE vide. Le vrai .env contenant les secrets
#   ne doit exister que sur les machines autorisées.
# ============================================================


# ── MODE D'ENTREE ─────────────────────────────────────────────────────────────
#
# Deux modes disponibles :
#   api  → Le script interroge l'API REST iTop (comportement original)
#   xlsx → Le script lit un fichier Excel déjà exporté depuis iTop (nouveau)
#
# En mode "xlsx" :
#   - ITOP_BASE_URL et ITOP_API_TOKEN ne sont PAS obligatoires
#   - LOCAL_XLSX_PATH devient obligatoire
#
# En mode "api" :
#   - ITOP_BASE_URL et ITOP_API_TOKEN sont obligatoires
#   - LOCAL_XLSX_PATH est ignoré
#
INPUT_MODE=api


# ── CONNEXION ITOP (requis si INPUT_MODE=api) ──────────────────────────────────

# URL de base de votre instance iTop (sans slash final)
# Exemple : https://itop.mabanque.local  ou  https://itsm.example.com
ITOP_BASE_URL=

# Token API iTop (généré dans iTop > Admin > Tokens REST)
# Ne jamais écrire ce token dans le code source
ITOP_API_TOKEN=

# Version de l'API REST iTop (généralement 1.3 — ne pas modifier sauf indication)
ITOP_API_VERSION=1.3

# Classe iTop à interroger
# UserRequest = Incidents standard iTop
# Incident    = si votre iTop utilise la classe Incident séparément
ITOP_CLASS=UserRequest

# Vérification du certificat SSL (True obligatoire en production)
# Mettre False UNIQUEMENT en environnement de test avec certificat auto-signé
ITOP_VERIFY_SSL=True


# ── FICHIER EXCEL LOCAL (requis si INPUT_MODE=xlsx) ──────────────────────────

# Chemin vers le fichier Excel exporté depuis iTop
# Exemple Windows : C:\Users\BestPc\Downloads\Export de Incidents (45).xlsx
# Exemple relatif : ./data/Export de Incidents -Maintenance & supports (45).xlsx
LOCAL_XLSX_PATH=

# Nom de la feuille Excel à lire
# Laisser vide pour utiliser la première feuille du classeur
LOCAL_XLSX_SHEET_NAME=Sheet1


# ── PIPELINE ──────────────────────────────────────────────────────────────────

# Mode de sortie des données : "sharepoint" ou "sql"
OUTPUT_MODE=sharepoint

# Fichier d'état pour l'extraction incrémentale (utilisé uniquement en mode api)
LAST_RUN_FILE=last_run.json

# Nom du fichier plat legacy (utilisé avec --legacy-flat)
EXPORT_FILE=incidents_itop_clean.xlsx

# Nom du classeur multi-feuilles modèle en étoile (mode normal)
MODEL_EXPORT_FILE=incidents_itop_model.xlsx

# Niveau de verbosité des logs : DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# ── SÉCURITÉ / PII ─────────────────────────────────────────────────────────────
#
# Inclure le nom de l'intervenant en clair dans les faits (défaut : True).
#   True  → agent_name conservé tel quel (utile page "tickets ouverts" Power BI)
#   False → agent_name remplacé par un hash SHA-256 de 8 chars (pseudonymisation)
# Les autres PII (emails, numéros d'employé, prénom/nom demandeur) sont TOUJOURS
# supprimés, indépendamment de cette variable.
#
INCLUDE_AGENT_NAME=True

# Sel utilisé pour le hash SHA-256 de agent_name (actif uniquement si INCLUDE_AGENT_NAME=False).
# Choisir une valeur aléatoire longue (>= 32 chars) et la conserver stable
# d'une exécution à l'autre pour que les hashes soient comparables dans Power BI.
# Ne jamais committer ce sel dans Git.
#
PII_SALT=CHANGER_CE_PLACEHOLDER_PAR_UNE_VALEUR_ALEATOIRE_LONGUE


# ── SHAREPOINT (requis si OUTPUT_MODE=sharepoint) ──────────────────────────────
# Créer une application dans Azure AD > App registrations
# Accorder la permission applicative : Files.ReadWrite.All
# Accorder le consentement administrateur

# ID du tenant Azure AD (visible dans Azure Portal > Azure Active Directory)
SHAREPOINT_TENANT_ID=

# Client ID de l'application Azure AD (visible dans App registrations)
SHAREPOINT_CLIENT_ID=

# Secret de l'application Azure AD (créer dans App registrations > Certificates & secrets)
SHAREPOINT_CLIENT_SECRET=

# ID du site SharePoint cible
# Obtenir via : GET https://graph.microsoft.com/v1.0/sites?search=<nom-site>
SHAREPOINT_SITE_ID=

# ID du drive (bibliothèque de documents SharePoint)
# Obtenir via : GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
SHAREPOINT_DRIVE_ID=

# Chemin du dossier cible dans la bibliothèque (vide = racine)
# Exemple : Rapports/iTop  ou  DataPipeline/Incidents
SHAREPOINT_FOLDER_PATH=Rapports/iTop


# ── SQL (requis si OUTPUT_MODE=sql) ───────────────────────────────────────────
# Dialecte SQLAlchemy : mssql+pyodbc (SQL Server) ou postgresql+psycopg2
SQL_DIALECT=mssql+pyodbc

# Hôte ou adresse IP du serveur SQL
SQL_HOST=

# Port du serveur SQL (1433 pour SQL Server, 5432 pour PostgreSQL)
SQL_PORT=1433

# Nom de la base de données cible
SQL_DATABASE=

# Utilisateur SQL (utiliser un compte dédié avec droits limités à la table cible)
SQL_USER=

# Mot de passe SQL (jamais en clair dans le code)
SQL_PASSWORD=

# Nom de la table cible (sera créée ou remplacée à chaque exécution)
SQL_TABLE=incidents_itop_clean


# ── ENRICHISSEMENT IA — Groq (module optionnel) ────────────────────────────────
#
# Module désactivé par défaut. Si AI_ENRICHMENT_ENABLED=False ou si
# GROQ_API_KEY est vide, le pipeline tourne exactement comme sans ce bloc
# (colonnes IA à NaN, aucun appel réseau).
#
# Active la classification IA (UC1) et la synthèse mensuelle (UC4).
AI_ENRICHMENT_ENABLED=False

# Clé API Groq. Ne jamais committer une vraie clé dans Git.
GROQ_API_KEY=

# Modèle Groq pour la classification UC1 (petit modèle rapide/économique —
# appelé en lots de 10 sur l'ensemble des tickets éligibles).
GROQ_MODEL=llama-3.1-8b-instant

# Modèle Groq pour la synthèse mensuelle UC4 (un seul appel par mois — peut
# se permettre un modèle plus qualitatif/volumineux que celui d'UC1).
GROQ_MODEL_SUMMARY=openai/gpt-oss-120b

# URL de base de l'API Groq, compatible OpenAI (sans slash final).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Limite de requêtes par minute vers l'API Groq (rate limiting côté client).
# Valeurs par défaut alignées sur le tier gratuit Groq pour llama-3.1-8b-instant
# (voir console.groq.com/settings/limits) : 30 RPM / 14,4K RPD / 6K TPM / 500K TPD.
GROQ_MAX_REQ_PER_MIN=30

# Limite de TOKENS par minute — souvent la contrainte réellement bloquante,
# bien plus stricte que le RPM (un lot de 10 tickets peut faire 700-1000+
# tokens ; à 6000 TPM cela plafonne à ~6-8 appels/min, pas 30). Ajuster selon
# le modèle GROQ_MODEL utilisé et votre tier (console.groq.com/settings/limits).
GROQ_MAX_TOKENS_PER_MIN=6000

# Seuil de confiance à partir duquel la catégorie IA remplace la catégorie
# regex dans root_cause_category_final (0.0 à 1.0).
AI_CONFIDENCE_THRESHOLD=0.6

# Nombre de tickets regroupés par appel API pour la classification (UC1).
AI_BATCH_SIZE=10


# ── CLASSIFICATION "SUPPORT MONÉTIQUE" — Groq (module optionnel, indépendant) ──
#
# Traitement indépendant de AI_ENRICHMENT_ENABLED : classe uniquement les
# tickets où service_subcategory == "Support Monétique" selon un référentiel
# métier figé (macro-catégories, thèmes, responsabilité), à partir du titre +
# de la description du ticket. Désactivé par défaut.
MONETIQUE_AI_ENABLED=False

# Seuil de confiance utilisé uniquement pour le reporting (aucun repli regex
# n'existe pour ce module — le thème choisi par le LLM est toujours écrit).
MONETIQUE_CONFIDENCE_THRESHOLD=0.6


# ============================================================
# EXEMPLES DE CONFIGURATION
# ============================================================
#
# Exemple 1 — Mode API iTop vers SharePoint (configuration originale)
# ──────────────────────────────────────────────────────────────────
# INPUT_MODE=api
# ITOP_BASE_URL=https://itop.mabanque.local
# ITOP_API_TOKEN=votre_token_ici
# OUTPUT_MODE=sharepoint
# SHAREPOINT_TENANT_ID=...
# SHAREPOINT_CLIENT_ID=...
# SHAREPOINT_CLIENT_SECRET=...
# SHAREPOINT_DRIVE_ID=...
# SHAREPOINT_FOLDER_PATH=Rapports/iTop
#
# Exemple 2 — Mode fichier Excel vers SharePoint (nouveau mode)
# ──────────────────────────────────────────────────────────────────
# INPUT_MODE=xlsx
# LOCAL_XLSX_PATH=./data/Export de Incidents -Maintenance & supports  (45).xlsx
# LOCAL_XLSX_SHEET_NAME=Sheet1
# OUTPUT_MODE=sharepoint
# SHAREPOINT_TENANT_ID=...
# SHAREPOINT_CLIENT_ID=...
# SHAREPOINT_CLIENT_SECRET=...
# SHAREPOINT_DRIVE_ID=...
# SHAREPOINT_FOLDER_PATH=Rapports/iTop
# EXPORT_FILE=incidents_itop_clean.xlsx
#
# Exemple 3 — Mode API iTop vers SQL Server
# ──────────────────────────────────────────────────────────────────
# INPUT_MODE=api
# ITOP_BASE_URL=https://itop.mabanque.local
# ITOP_API_TOKEN=votre_token_ici
# OUTPUT_MODE=sql
# SQL_DIALECT=mssql+pyodbc
# SQL_HOST=sql-server.mabanque.local
# SQL_PORT=1433
# SQL_DATABASE=DataWarehouse
# SQL_USER=itop_pipeline_user
# SQL_PASSWORD=VotreMotDePasseIci
# SQL_TABLE=incidents_itop_clean
